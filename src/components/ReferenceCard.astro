---
import projectImages from '../data/project-images.json';
const { project } = Astro.props;
const image = projectImages[project.image];
if (!image) throw new Error(`Missing responsive image variants for ${project.image}`);
const small = image.variants['480'];
const large = image.variants['960'];
---
<article class="reference-card">
  <img
    src={large.src}
    srcset={`${small.src} 480w,${large.src} 960w`}
    sizes="(max-width: 700px) 100vw, 33vw"
    width={large.width}
    height={large.height}
    alt={project.name}
    loading="lazy"
    decoding="async"
  />
  <div>
    <p>{project.location}</p><h3>{project.name}</h3>
    <dl><div><dt>Ketinggian</dt><dd>{project.floors}</dd></div><div><dt>Periode</dt><dd>{project.period}</dd></div></dl>
  </div>
</article>
