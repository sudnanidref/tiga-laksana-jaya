---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title,
  description,
  canonical,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://tigalaksanajaya.com/assets/company-cover-e7e7380822.webp',
  active = '',
  schemas = [],
} = Astro.props;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#07111f" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon-tlj-48.png?v=20260816-tlj-favicon" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-tlj-192.png?v=20260816-tlj-favicon" />
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico?v=20260816-tlj-favicon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon-tlj-180.png?v=20260816-tlj-favicon" />
    <link rel="manifest" href="/site.webmanifest.json?v=20260816-tlj-favicon" />
    <link rel="stylesheet" href="/assets/styles.css?v=20261018-project-refresh" />
    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  </head>
  <body>
    <Header active={active} />
    <main id="main"><slot /></main>
    <Footer />
    <script src="/assets/script.js?v=20260809-cover-refresh" defer></script>
  </body>
</html>
